<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/settings_title"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiet_hours_title"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_quiet_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiet_hours_enable" />

            <Button
                android:id="@+id/button_start"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/button_end"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:id="@+id/radio_quiet_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radio_silent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quiet_mode_silent" />

                <RadioButton
                    android:id="@+id/radio_priority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quiet_mode_priority" />

                <RadioButton
                    android:id="@+id/radio_vibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quiet_mode_vibrate" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_critical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allow_critical" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_announce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiet_announce" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_system_dnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply_system_dnd" />

            <Button
                android:id="@+id/button_dnd_access"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_dnd_access" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/focus_title"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_focus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/focus_enable" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_by_category" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_title"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:layout_marginTop="20dp" />

            <Button
                android:id="@+id/button_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_export" />

            <Button
                android:id="@+id/button_import"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/backup_import" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
