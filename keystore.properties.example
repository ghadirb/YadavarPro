# Copy this file to keystore.properties in the project root (gitignored).
# Put yadavar-release.jks next to it, or use an absolute path.
#
# Do NOT commit keystore.properties or the .jks file.
# The same key must sign every Cafe Bazaar / Myket update.

storeFile=yadavar-release.jks
storePassword=PUT_STORE_PASSWORD_HERE
keyAlias=yadavar_pro_key
keyPassword=PUT_KEY_PASSWORD_HERE

# Cafe Bazaar / Myket RSA public keys (from each store's developer panel).
# Also set the same names as GitHub Actions secrets.
BAZAAR_IAB_PUBLIC_KEY=
MYKET_IAB_PUBLIC_KEY=
